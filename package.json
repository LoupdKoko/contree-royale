{
  "name": "contree-royale",
  "private": true,
  "version": "1.1.1",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build --base=./",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist.exe": "vite build --base=./ && electron-builder --win portable"
  },
  "build": {
    "appId": "com.loup.contreeroyale.app",
    "productName": "ContreeRoyale",
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "public/icon.ico"
    ],
    "win": {
      "target": "portable",
      "icon": "public/icon.ico"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "firebase": "^13.2.0",
    "lucide-react": "^1.70.0",
    "peerjs": "^1.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.90.0",
    "vite": "^8.3.6"
  }
}
